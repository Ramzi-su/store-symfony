{% extends 'base.html.twig' %}

{% block title %}Panier - MiniStore{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    // Quantity changes are saved right away; the form still works without JavaScript (Update button).
    document.querySelectorAll('.quantity-form').forEach(function (form) {
      form.querySelector('.quantity-input').addEventListener('change', function () { form.submit(); });
    });
  </script>
{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/header.html.twig' %}

  {% include 'partials/breadcrumb.html.twig' with {page_title: 'Panier'} %}

  <main class="container ms-cart">
    {% for type, alertClass in {'success': 'success', 'warning': 'warning', 'error': 'danger'} %}
      {% for message in app.flashes(type) %}
        <div class="alert alert-{{ alertClass }}" role="alert">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    {% if cart_items is empty %}
      <div class="ms-empty">
        <h2>Votre panier est vide</h2>
        <p>Parcourez la boutique pour ajouter des produits.</p>
        <a class="btn btn-primary" href="{{ path('app_shop') }}">Voir la boutique</a>
      </div>
    {% else %}
      <div class="ms-cart__grid">
        <section aria-labelledby="cart-lines-title">
          <h2 id="cart-lines-title" class="ms-visually-hidden">Articles</h2>
          <ul class="ms-cart__lines">
            {% for item in cart_items %}
              <li class="ms-line">
                <a class="ms-line__media" href="{{ path('app_single_product', {slug: item.product.slug}) }}" tabindex="-1" aria-hidden="true">
                  {% if item.product.image %}<img src="{{ asset(item.product.image) }}" alt="" width="96" height="96">{% endif %}
                </a>

                <div class="ms-line__info">
                  <a class="ms-line__name" href="{{ path('app_single_product', {slug: item.product.slug}) }}">{{ item.product.name }}</a>
                  {% if item.color or item.storage %}
                    <p class="ms-line__options">{{ [item.color, item.storage]|filter(v => v)|join(', ') }}</p>
                  {% endif %}
                  <p class="ms-line__unit ms-price">{{ item.product.price|money }} l’unité</p>
                </div>

                <form class="quantity-form ms-line__qty" action="{{ path('app_cart_update', {'id': item.product.id}) }}" method="post">
                  <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                  <input type="hidden" name="color" value="{{ item.color }}">
                  <input type="hidden" name="storage" value="{{ item.storage }}">
                  <label>
                    <span class="ms-visually-hidden">Quantité de {{ item.product.name }}</span>
                    <input class="form-control quantity-input" type="number" name="quantity" value="{{ item.quantity }}"
                           min="1" max="{{ min(item.product.stock, 99) }}">
                  </label>
                  <noscript><button type="submit" class="btn btn-outline-dark btn-sm">Mettre à jour</button></noscript>
                </form>

                <p class="ms-line__subtotal ms-price">{{ item.subtotal|money }}</p>

                <form class="ms-line__remove" action="{{ path('app_cart_remove', {'id': item.product.id}) }}" method="post">
                  <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                  <input type="hidden" name="color" value="{{ item.color }}">
                  <input type="hidden" name="storage" value="{{ item.storage }}">
                  <button type="submit" class="ms-action" title="Retirer">
                    <svg class="ms-icon" aria-hidden="true"><use href="#trash"></use></svg>
                    <span class="ms-visually-hidden">Retirer {{ item.product.name }} du panier</span>
                  </button>
                </form>
              </li>
            {% endfor %}
          </ul>

          <div class="ms-cart__after">
            <a class="ms-link" href="{{ path('app_shop') }}">Continuer mes achats</a>
            <form action="{{ path('app_cart_clear') }}" method="post" onsubmit="return confirm('Vider le panier ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
              <button type="submit" class="btn btn-link ms-cart__clear">Vider le panier</button>
            </form>
          </div>
        </section>

        <aside class="cart-summary ms-summary" aria-labelledby="summary-title">
          <h2 id="summary-title">Récapitulatif</h2>
          <dl>
            <div><dt>Sous-total</dt><dd class="ms-price">{{ cart_subtotal|money }}</dd></div>
            <div><dt>Livraison</dt><dd class="ms-price">{{ shipping_cost|money }}</dd></div>
            <div><dt>Taxes ({{ constant('App\\Cart\\CartTotals::TAX_RATE_PERCENT') }} %)</dt><dd class="ms-price">{{ tax|money }}</dd></div>
            <div class="ms-summary__total"><dt>Total</dt><dd class="ms-price">{{ cart_total|money }}</dd></div>
          </dl>
          <a class="btn btn-primary btn-lg w-100" href="{{ path('app_checkout') }}">Passer la commande</a>
          <p class="ms-summary__note">
            <svg class="ms-icon" aria-hidden="true"><use href="#lock"></use></svg>
            Paiement sécurisé par Stripe
          </p>
        </aside>
      </div>
    {% endif %}
  </main>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
