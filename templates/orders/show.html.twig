{% extends 'base.html.twig' %}

{% block title %}Détail commande #{{ order.id }}{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/search_popup.html.twig' %}
  {% include 'partials/header.html.twig' %}

  {% include 'partials/breadcrumb.html.twig' with {
    'page_title': 'Détails de la commande #' ~ order.id
  } %}

  <section class="padding-large">
    <div class="container">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h4 class="mb-0">
            <i class="bi bi-receipt-cutoff me-2"></i> Commande #{{ order.id }}
          </h4>
        </div>

        <div class="card-body">
          <table class="table table-bordered">
            <tbody>
              <tr>
                <th scope="row">ID</th>
                <td>{{ order.id }}</td>
              </tr>
              <tr>
                <th scope="row">Total</th>
                <td>${{ order.total|number_format(2, '.', ',') }}</td>
              </tr>
              <tr>
                <th scope="row">Statut</th>
                <td>
                  {{ include('orders/_status_badge.html.twig', {status: order.status}) }}
                </td>
              </tr>
              <tr>
                <th scope="row">Date de création</th>
                <td>{{ order.createdAt ? order.createdAt|date('d/m/Y H:i') : '' }}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="card-footer d-flex justify-content-between">
          <a href="{{ path('app_orders_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Retour à la liste
          </a>

          <div>
            <a href="{{ path('app_orders_edit', {'id': order.id}) }}" class="btn btn-outline-primary me-2">
              <i class="bi bi-pencil-square me-1"></i> Modifier
            </a>

            {{ include('orders/_delete_form.html.twig') }}
          </div>
        </div>
      </div>
    </div>
  </section>

  {% include 'partials/subscribe.html.twig' %}
  {% include 'partials/footer.html.twig' %}
{% endblock %}
