{% extends 'base.html.twig' %}

{% block title %}{{ 'contact.confirmation.title'|trans }}{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/header.html.twig' %}

  <section class="container py-5 text-center">
    <div class="row justify-content-center">
      <div class="col-md-8">
        <h1 class="mb-4 text-success">✅ {{ 'contact.confirmation.heading'|trans }}</h1>
        <p class="lead">{{ 'contact.confirmation.body'|trans }}</p>
        <a href="{{ path('app_home') }}" class="btn btn-outline-primary mt-4">
          {{ 'contact.confirmation.back_home'|trans }}
        </a>
      </div>
    </div>
  </section>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
