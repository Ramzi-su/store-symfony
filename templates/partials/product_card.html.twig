{# Product tile. Expects "product". Stock status is the real value, not decoration. #}
{% set url = path('app_single_product', {slug: product.slug}) %}
{% set low_stock_threshold = 3 %}

<article class="ms-tile">
  <a class="ms-tile__media" href="{{ url }}" tabindex="-1" aria-hidden="true">
    {% if product.image %}
      <img src="{{ asset(product.image) }}" alt="" loading="lazy" width="400" height="400">
    {% endif %}
    {% if product.isIsSale %}<span class="ms-tile__badge">Promo</span>{% endif %}
  </a>

  <div class="ms-tile__body">
    <p class="ms-tile__category">{{ product.category|category_label }}</p>
    <h3 class="ms-tile__name"><a href="{{ url }}">{{ product.name }}</a></h3>

    <div class="ms-tile__meta">
      <span class="ms-tile__price ms-price">{{ product.price|money }}</span>
      {% if product.stock <= 0 %}
        <span class="ms-stock ms-stock--out">Épuisé</span>
      {% elseif product.stock <= low_stock_threshold %}
        <span class="ms-stock ms-stock--low">Plus que {{ product.stock }}</span>
      {% else %}
        <span class="ms-stock">En stock</span>
      {% endif %}
    </div>

    {% if product.stock > 0 %}
      <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
        <button type="submit" class="btn btn-primary ms-tile__cta">
          Ajouter au panier<span class="ms-visually-hidden"> : {{ product.name }}</span>
        </button>
      </form>
    {% else %}
      <button type="button" class="btn ms-tile__cta" disabled>Indisponible</button>
    {% endif %}
  </div>
</article>
