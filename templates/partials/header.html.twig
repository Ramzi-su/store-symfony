{% set route = app.request.attributes.get('_route') %}
{% set nav = [
  {route: 'app_shop', label: 'Boutique'},
  {route: 'app_about', label: 'À propos'},
  {route: 'app_contact', label: 'Contact'},
] %}

<header class="ms-header">
  <div class="container ms-header__inner">
    <a class="ms-brand" href="{{ path('app_home') }}">MiniStore</a>

    <nav aria-label="Navigation principale">
      <ul class="ms-nav">
        {% for item in nav %}
          <li><a href="{{ path(item.route) }}" {% if route == item.route %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <form class="ms-search" role="search" method="get" action="{{ path('app_shop') }}">
      <label for="header-search" class="ms-visually-hidden">Rechercher un produit</label>
      <svg class="ms-icon" aria-hidden="true"><use href="#search"></use></svg>
      <input type="search" id="header-search" name="q" placeholder="Rechercher un produit" value="{{ app.request.query.get('q') }}" maxlength="100">
    </form>

    <div class="ms-actions">
      <div class="ms-lang-switch">
        <a href="{{ path('app_set_locale', {locale: 'fr'}) }}"
           class="ms-lang-btn {% if app.request.locale == 'fr' %}ms-lang-btn--active{% endif %}"
           aria-label="Français">FR</a>
        <span class="ms-lang-sep">|</span>
        <a href="{{ path('app_set_locale', {locale: 'en'}) }}"
           class="ms-lang-btn {% if app.request.locale == 'en' %}ms-lang-btn--active{% endif %}"
           aria-label="English">EN</a>
      </div>
      <div class="dropdown">
        <button class="ms-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <svg class="ms-icon" aria-hidden="true"><use href="#user"></use></svg>
          <span class="ms-visually-hidden">Compte</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          {% if app.user %}
            <li class="ms-account-name">{{ app.user.userIdentifier }}</li>
            <li><a class="dropdown-item" href="{{ path('app_account') }}">Mon compte</a></li>
            <li><a class="dropdown-item" href="{{ path('app_orders') }}">Mes commandes</a></li>
            {% if is_granted('ROLE_ADMIN') %}
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="{{ path('admin_dashboard') }}">Administration</a></li>
            {% endif %}
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="{{ path('app_logout') }}">Se déconnecter</a></li>
          {% else %}
            <li><a class="dropdown-item" href="{{ path('app_login') }}">Se connecter</a></li>
            <li><a class="dropdown-item" href="{{ path('app_register') }}">Créer un compte</a></li>
          {% endif %}
        </ul>
      </div>

      {% set count = cart_count is defined ? cart_count : 0 %}
      <a class="ms-action" href="{{ path('app_cart') }}">
        <svg class="ms-icon" aria-hidden="true"><use href="#cart"></use></svg>
        <span class="ms-visually-hidden">Panier{% if count > 0 %}, {{ count }} article{{ count > 1 ? 's' }}{% endif %}</span>
        {% if count > 0 %}<span class="ms-cart-count" aria-hidden="true">{{ count }}</span>{% endif %}
      </a>

      <button class="ms-action ms-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#ms-mobile-menu" aria-controls="ms-mobile-menu">
        <svg class="ms-icon" aria-hidden="true"><use href="#navbar-icon"></use></svg>
        <span class="ms-visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<div class="offcanvas offcanvas-end ms-offcanvas" tabindex="-1" id="ms-mobile-menu" aria-labelledby="ms-mobile-menu-title">
  <div class="offcanvas-header">
    <span class="ms-brand" id="ms-mobile-menu-title">MiniStore</span>
    <button type="button" class="ms-action" data-bs-dismiss="offcanvas">
      <svg class="ms-icon" aria-hidden="true"><use href="#close"></use></svg>
      <span class="ms-visually-hidden">Fermer le menu</span>
    </button>
  </div>
  <div class="offcanvas-body">
    <form class="ms-search" role="search" method="get" action="{{ path('app_shop') }}">
      <label for="mobile-search" class="ms-visually-hidden">Rechercher un produit</label>
      <svg class="ms-icon" aria-hidden="true"><use href="#search"></use></svg>
      <input type="search" id="mobile-search" name="q" placeholder="Rechercher un produit" value="{{ app.request.query.get('q') }}" maxlength="100">
    </form>
    <ul class="ms-offcanvas-nav">
      {% for item in nav %}
        <li><a href="{{ path(item.route) }}" {% if route == item.route %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
