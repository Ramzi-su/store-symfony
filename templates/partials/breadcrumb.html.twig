{# Page title with its breadcrumb trail.
   Parameters: page_title (required), parent_page + parent_route (optional),
   show_title (default true: false when the page renders its own <h1>). #}
<section class="ms-page-title{{ (show_title ?? true) ? '' : ' ms-page-title--trail' }}">
  <div class="container">
    <nav aria-label="Fil d’Ariane">
      <ol class="ms-breadcrumb">
        <li><a href="{{ path('app_home') }}">Accueil</a></li>
        {% if parent_page is defined and parent_page %}
          <li><a href="{{ path(parent_route) }}">{{ parent_page == 'Shop' ? 'Boutique' : parent_page }}</a></li>
        {% endif %}
        <li aria-current="page">{{ page_title }}</li>
      </ol>
    </nav>
    {% if show_title ?? true %}<h1>{{ page_title }}</h1>{% endif %}
  </div>
</section>
