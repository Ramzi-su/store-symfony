{# Only facts the shop actually applies: shipping comes from the same constant as the cart. #}
<footer class="ms-footer">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4">
        <a class="ms-brand" href="{{ path('app_home') }}">MiniStore</a>
        <p class="mt-3">Smartphones, montres connectées et audio.</p>
        <ul class="ms-footer__facts mt-3">
          <li>
            <svg class="ms-icon" aria-hidden="true"><use href="#truck"></use></svg>
            <span>Livraison {{ constant('App\\Cart\\CartTotals::SHIPPING_COST')|money }} par commande</span>
          </li>
          <li>
            <svg class="ms-icon" aria-hidden="true"><use href="#lock"></use></svg>
            <span>Paiement sécurisé par Stripe</span>
          </li>
        </ul>
      </div>

      <nav class="col-6 col-lg-2 offset-lg-2" aria-labelledby="footer-shop">
        <h2 id="footer-shop">Boutique</h2>
        <ul>
          <li><a href="{{ path('app_shop') }}">Tous les produits</a></li>
          <li><a href="{{ path('app_cart') }}">Panier</a></li>
        </ul>
      </nav>

      <nav class="col-6 col-lg-2" aria-labelledby="footer-account">
        <h2 id="footer-account">Compte</h2>
        <ul>
          {% if app.user %}
            <li><a href="{{ path('app_account') }}">Mon compte</a></li>
            <li><a href="{{ path('app_orders') }}">Mes commandes</a></li>
          {% else %}
            <li><a href="{{ path('app_login') }}">Se connecter</a></li>
            <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
          {% endif %}
        </ul>
      </nav>

      <nav class="col-6 col-lg-2" aria-labelledby="footer-help">
        <h2 id="footer-help">Aide</h2>
        <ul>
          <li><a href="{{ path('app_contact') }}">Contact</a></li>
          <li><a href="{{ path('app_about') }}">À propos</a></li>
        </ul>
      </nav>
    </div>

    <div class="ms-footer__bottom">© {{ 'now'|date('Y') }} MiniStore</div>
  </div>
</footer>
