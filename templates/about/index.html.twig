{% extends 'base.html.twig' %}

{% block title %}{{ 'about.title'|trans }} - Ministore{% endblock %}

{% block body %}
    {% include 'partials/svg_icons.html.twig' %}
    {% include 'partials/header.html.twig' %}
    
    {% include 'partials/breadcrumb.html.twig' with {
        'page_title': 'about.title'|trans
    } %}
    
    <section class="about-section padding-large">
      <div class="container">
        <div class="row">
          <div class="col-md-6">
            <div class="image-holder">
              <img src="{{ asset('images/about-image.jpg') }}" alt="about us" class="img-fluid">
            </div>
          </div>
          <div class="col-md-6">
            <div class="about-content">
              <h2 class="display-5 text-uppercase text-dark mb-4">{{ 'about.story.title'|trans }}</h2>
              <p>{{ 'about.story.p1'|trans }}</p>
              <p>{{ 'about.story.p2'|trans }}</p>
              <p>{{ 'about.story.p3'|trans }}</p>
              <a href="{{ path('app_shop') }}" class="btn btn-medium btn-dark text-uppercase btn-rounded-none mt-3">{{ 'about.shop_now'|trans }}</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="our-team bg-light-blue padding-large">
      <div class="container">
        <div class="row">
          <div class="col-12 text-center mb-5">
            <h2 class="display-5 text-uppercase text-dark">{{ 'about.team.title'|trans }}</h2>
            <p class="w-50 mx-auto">{{ 'about.team.subtitle'|trans }}</p>
          </div>
        </div>
        <div class="row">
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="team-member text-center">
              <div class="member-image">
                <img src="{{ asset('images/team-member1.jpg') }}" alt="team member" class="img-fluid rounded-circle">
              </div>
              <div class="member-details mt-3">
                <h4 class="text-uppercase">John Smith</h4>
                <p class="text-muted">Founder & CEO</p>
                <div class="social-links mt-2">
                  <a href="#" class="me-2"><svg class="facebook"><use xlink:href="#facebook"></use></svg></a>
                  <a href="#" class="me-2"><svg class="twitter"><use xlink:href="#twitter"></use></svg></a>
                  <a href="#" class="me-2"><svg class="instagram"><use xlink:href="#instagram"></use></svg></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="team-member text-center">
              <div class="member-image">
                <img src="{{ asset('images/team-member2.jpg') }}" alt="team member" class="img-fluid rounded-circle">
              </div>
              <div class="member-details mt-3">
                <h4 class="text-uppercase">Sarah Johnson</h4>
                <p class="text-muted">Marketing Director</p>
                <div class="social-links mt-2">
                  <a href="#" class="me-2"><svg class="facebook"><use xlink:href="#facebook"></use></svg></a>
                  <a href="#" class="me-2"><svg class="twitter"><use xlink:href="#twitter"></use></svg></a>
                  <a href="#" class="me-2"><svg class="instagram"><use xlink:href="#instagram"></use></svg></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="team-member text-center">
              <div class="member-image">
                <img src="{{ asset('images/team-member3.jpg') }}" alt="team member" class="img-fluid rounded-circle">
              </div>
              <div class="member-details mt-3">
                <h4 class="text-uppercase">Michael Brown</h4>
                <p class="text-muted">Product Manager</p>
                <div class="social-links mt-2">
                  <a href="#" class="me-2"><svg class="facebook"><use xlink:href="#facebook"></use></svg></a>
                  <a href="#" class="me-2"><svg class="twitter"><use xlink:href="#twitter"></use></svg></a>
                  <a href="#" class="me-2"><svg class="instagram"><use xlink:href="#instagram"></use></svg></a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6 mb-4">
            <div class="team-member text-center">
              <div class="member-image">
                <img src="{{ asset('images/team-member4.jpg') }}" alt="team member" class="img-fluid rounded-circle">
              </div>
              <div class="member-details mt-3">
                <h4 class="text-uppercase">Emily Davis</h4>
                <p class="text-muted">Customer Service</p>
                <div class="social-links mt-2">
                  <a href="#" class="me-2"><svg class="facebook"><use xlink:href="#facebook"></use></svg></a>
                  <a href="#" class="me-2"><svg class="twitter"><use xlink:href="#twitter"></use></svg></a>
                  <a href="#" class="me-2"><svg class="instagram"><use xlink:href="#instagram"></use></svg></a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="our-values padding-large">
      <div class="container">
        <div class="row">
          <div class="col-12 text-center mb-5">
            <h2 class="display-5 text-uppercase text-dark">{{ 'about.values.title'|trans }}</h2>
            <p class="w-50 mx-auto">{{ 'about.values.subtitle'|trans }}</p>
          </div>
        </div>
        <div class="row">
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="value-item text-center p-4 border">
              <div class="icon-box mb-3">
                <svg class="quality" width="48" height="48"><use xlink:href="#quality"></use></svg>
              </div>
              <h3 class="text-uppercase">{{ 'about.values.quality.title'|trans }}</h3>
              <p>{{ 'about.values.quality.desc'|trans }}</p>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="value-item text-center p-4 border">
              <div class="icon-box mb-3">
                <svg class="shield-plus" width="48" height="48"><use xlink:href="#shield-plus"></use></svg>
              </div>
              <h3 class="text-uppercase">{{ 'about.values.integrity.title'|trans }}</h3>
              <p>{{ 'about.values.integrity.desc'|trans }}</p>
            </div>
          </div>
          <div class="col-lg-4 col-md-6 mb-4">
            <div class="value-item text-center p-4 border">
              <div class="icon-box mb-3">
                <svg class="cart-outline" width="48" height="48"><use xlink:href="#cart-outline"></use></svg>
              </div>
              <h3 class="text-uppercase">{{ 'about.values.customer.title'|trans }}</h3>
              <p>{{ 'about.values.customer.desc'|trans }}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    {% include 'partials/footer.html.twig' %}
{% endblock %}