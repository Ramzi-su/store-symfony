{% extends 'base.html.twig' %}

{% set heading = filters.query != '' ? 'Résultats pour « ' ~ filters.query ~ ' »'
  : (filters.category ? filters.category|category_label : 'Boutique') %}

{% block title %}{{ heading }} - MiniStore{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/header.html.twig' %}

  {% include 'partials/breadcrumb.html.twig' with {
    page_title: heading,
    parent_page: heading != 'Boutique' ? 'Boutique' : null,
    parent_route: 'app_shop',
  } %}

  <main class="container ms-shop">
    <div class="ms-shop__layout">
      {# One GET form for filters and sort: every combination is a shareable URL.
         It wraps the filters only: tiles contain their own add-to-cart forms, and
         forms cannot be nested. The sort select joins it through form="shop-filters". #}
      <form id="shop-filters" method="get" action="{{ path('app_shop') }}">
      {% if filters.query != '' %}<input type="hidden" name="q" value="{{ filters.query }}">{% endif %}

      <details class="ms-filters" open>
        <summary>Filtres</summary>

        <fieldset>
          <legend>Catégorie</legend>
          <label class="ms-choice">
            <input type="radio" name="category" value="" {% if filters.category is null %}checked{% endif %}>
            Toutes
          </label>
          {% for category, total in categories %}
            <label class="ms-choice">
              <input type="radio" name="category" value="{{ category }}" {% if filters.category == category %}checked{% endif %}>
              {{ category|category_label }} <span class="ms-choice__count">{{ total }}</span>
            </label>
          {% endfor %}
        </fieldset>

        <fieldset>
          <legend>Prix ($)</legend>
          <div class="ms-price-range">
            <label>
              <span class="ms-visually-hidden">Prix minimum</span>
              <input class="form-control" type="number" name="min" min="0" step="1" inputmode="numeric" placeholder="Min"
                     value="{{ filters.minPriceCents is not null ? filters.minPriceCents / 100 : '' }}">
            </label>
            <span aria-hidden="true">à</span>
            <label>
              <span class="ms-visually-hidden">Prix maximum</span>
              <input class="form-control" type="number" name="max" min="0" step="1" inputmode="numeric" placeholder="Max"
                     value="{{ filters.maxPriceCents is not null ? filters.maxPriceCents / 100 : '' }}">
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend>Disponibilité</legend>
          <label class="ms-choice">
            <input type="checkbox" name="stock" value="1" {% if filters.inStockOnly %}checked{% endif %}>
            En stock uniquement
          </label>
        </fieldset>

        <div class="ms-filters__actions">
          <button type="submit" class="btn btn-primary">Appliquer</button>
          {% if filters.isFiltered %}
            <a class="ms-link" href="{{ path('app_shop') }}">Effacer les filtres</a>
          {% endif %}
        </div>
      </details>
      </form>
      {# Phones: start with the filters folded so products are visible first (unless a filter is active). #}
      <script>
        if (window.matchMedia('(max-width: 991.98px)').matches && {{ filters.isFiltered ? 'false' : 'true' }}) {
          document.querySelector('#shop-filters .ms-filters').removeAttribute('open');
        }
      </script>

      <section class="ms-results" aria-labelledby="results-count">
        <div class="ms-results__bar">
          <p id="results-count" class="ms-results__count">
            {{ page.totalCount }} produit{{ page.totalCount > 1 ? 's' }}
          </p>
          <label class="ms-sort">
            Trier par
            <select class="form-select" name="tri" form="shop-filters" onchange="this.form.submit()">
              {% for value, label in sorts %}
                <option value="{{ value }}" {% if filters.sort == value %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
          </label>
        </div>

        {% if page.items is not empty %}
          <div class="ms-grid">
            {% for product in page.items %}
              {% include 'partials/product_card.html.twig' with {product: product} %}
            {% endfor %}
          </div>
        {% else %}
          <div class="ms-empty">
            <p>Aucun produit ne correspond à ces filtres.</p>
            <a class="btn btn-outline-dark" href="{{ path('app_shop') }}">Voir tous les produits</a>
          </div>
        {% endif %}

        {% if page.pageCount > 1 %}
          {% set params = app.request.query.all %}
          <nav class="ms-pagination" aria-label="Pages de résultats">
            {% if page.hasPreviousPage %}
              <a href="{{ path('app_shop', params|merge({page: page.pageNumber - 1})) }}" rel="prev">Précédent</a>
            {% endif %}
            {% for n in 1..page.pageCount %}
              {% if n == page.pageNumber %}
                <span aria-current="page">{{ n }}</span>
              {% else %}
                <a href="{{ path('app_shop', params|merge({page: n})) }}">{{ n }}</a>
              {% endif %}
            {% endfor %}
            {% if page.hasNextPage %}
              <a href="{{ path('app_shop', params|merge({page: page.pageNumber + 1})) }}" rel="next">Suivant</a>
            {% endif %}
          </nav>
        {% endif %}
      </section>
    </div>
  </main>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
