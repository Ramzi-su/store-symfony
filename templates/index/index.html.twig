{% extends 'base.html.twig' %}

{% block title %}MiniStore : smartphones, montres et audio{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/header.html.twig' %}

  <main>
    <section class="ms-hero">
      <div class="container ms-hero__grid">
        <div>
          <h1>Smartphones, montres et audio.</h1>
          <p class="ms-hero__lead">Le stock affiché est le stock réel, et votre commande est réservée pendant le paiement.</p>
          <a class="btn btn-primary btn-lg" href="{{ path('app_shop') }}">Voir la boutique</a>
        </div>

        {% if featured %}
          <a class="ms-hero__feature" href="{{ path('app_single_product', {slug: featured.slug}) }}">
            {% if featured.image %}
              <img src="{{ asset(featured.image) }}" alt="{{ featured.name }}" width="800" height="640" fetchpriority="high">
            {% endif %}
            <span class="ms-hero__caption">
              <strong>{{ featured.name }}</strong>
              <span class="ms-price">{{ featured.price|money }}</span>
            </span>
          </a>
        {% endif %}
      </div>
    </section>

    {% if categories is not empty %}
      <section class="ms-section" aria-labelledby="home-categories">
        <div class="container">
          <div class="ms-section__head">
            <h2 id="home-categories">Catégories</h2>
          </div>
          <div class="ms-categories">
            {% for category, total in categories %}
              <a class="ms-category" href="{{ path('app_shop', {category: category}) }}">
                {{ category|category_label }}
                <span>{{ total }} produit{{ total > 1 ? 's' }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <section class="ms-section" aria-labelledby="home-new">
      <div class="container">
        <div class="ms-section__head">
          <h2 id="home-new">Nouveautés</h2>
          <a class="ms-link" href="{{ path('app_shop') }}">Voir tous les produits</a>
        </div>
        {% if new_arrivals is not empty %}
          <div class="ms-grid">
            {% for product in new_arrivals %}
              {% include 'partials/product_card.html.twig' with {product: product} %}
            {% endfor %}
          </div>
        {% else %}
          <p>Aucun produit pour le moment.</p>
        {% endif %}
      </div>
    </section>

    <div class="container">
      <ul class="ms-facts">
        <li>
          <svg class="ms-icon" aria-hidden="true"><use href="#truck"></use></svg>
          <div><strong>Livraison {{ constant('App\\Cart\\CartTotals::SHIPPING_COST')|money }}</strong><span>Un seul tarif par commande.</span></div>
        </li>
        <li>
          <svg class="ms-icon" aria-hidden="true"><use href="#lock"></use></svg>
          <div><strong>Paiement sécurisé</strong><span>Carte bancaire via Stripe, nous ne voyons jamais votre numéro.</span></div>
        </li>
        <li>
          <svg class="ms-icon" aria-hidden="true"><use href="#box"></use></svg>
          <div><strong>Stock réservé</strong><span>Vos articles sont mis de côté pendant 30 minutes de paiement.</span></div>
        </li>
      </ul>
    </div>
  </main>

  {% include 'partials/footer.html.twig' %}
{% endblock %}
