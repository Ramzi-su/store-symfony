{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Ministore{% endblock %}

{% block body %}
  {% include 'partials/svg_icons.html.twig' %}
  {% include 'partials/search_popup.html.twig' %}
  {% include 'partials/header.html.twig' %}

  {% include 'partials/breadcrumb.html.twig' with {
    'page_title': product.name,
    'parent_page': 'Shop',
    'parent_route': 'app_shop'
  } %}

  <section class="single-product-section padding-large">
    <div class="container">
      {% for type, alertClass in {'success': 'success', 'error': 'danger'} %}
        {% for message in app.flashes(type) %}
          <div class="alert alert-{{ alertClass }}" role="alert">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      <div class="row">
        <div class="col-md-6">
          <div class="product-images">
            <div class="main-image-container mb-3 position-relative">
              {% if product.isIsSale %}
                <div class="card-badge bg-primary text-white position-absolute top-0 start-0 m-2 py-1 px-2">Sale</div>
              {% endif %}
              {% if product.image %}
                <img src="{{ asset(product.image) }}" alt="{{ product.name }}" class="img-fluid main-image">
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="product-info mt-4 mt-md-0">
            <h2 class="product-title mb-3">{{ product.name }}</h2>

            <div class="product-price mb-3">
              <span class="price h4">{{ product.price|money }}</span>
            </div>

            <div class="product-description mb-4">
              {# Escaped by Twig first, then line breaks become <br>: no HTML from the database is trusted. #}
              <p>{{ product.description|nl2br }}</p>
            </div>

            <div class="product-actions mb-4">
              {% if product.stock > 0 %}
                <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post" class="add-to-cart-form">
                  <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                  <div class="quantity-selector d-flex align-items-center mb-3">
                    <label for="quantity" class="h6 me-3 mb-0">Quantity:</label>
                    <input type="number" id="quantity" name="quantity" value="1" min="1" max="{{ min(product.stock, 99) }}"
                           class="form-control form-control-sm text-center" style="width: 70px;">
                    <span class="ms-3 text-muted">{{ product.stock }} in stock</span>
                  </div>
                  <button type="submit" class="btn btn-primary">Add to Cart</button>
                </form>
              {% else %}
                <p class="text-danger fw-bold mb-3">Out of stock</p>
                <button type="button" class="btn btn-primary" disabled>Add to Cart</button>
              {% endif %}
            </div>

            <div class="product-meta">
              <div class="categories mb-2">
                <span class="fw-bold">Category:</span>
                <a href="{{ path('app_shop', {'category': product.category}) }}" class="text-decoration-none">{{ product.category|capitalize }}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {% if related_products is not empty %}
    {% include 'partials/related_products.html.twig' with {'related_products': related_products} %}
  {% endif %}
  {% include 'partials/subscribe.html.twig' %}
  {% include 'partials/footer.html.twig' %}
{% endblock %}
